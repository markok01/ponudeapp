# Kopiraj u .env.local i nalepi Aiven lozinku u MYSQL_PASSWORD
MYSQL_PASSWORD=your_aiven_password_here

MYSQL_HOST=mysql-75b205f-personalb.c.aivencloud.com
MYSQL_PORT=28711
MYSQL_USER=avnadmin
MYSQL_DATABASE=ponudaapp
# Na Vercelu (kad Shared MYSQL_DATABASE=defaultdb za Budget): Project env:
# PONUDEAPP_DATABASE=ponudaapp
PONUDEAPP_DATABASE=ponudaapp
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=false
# Na Vercelu NE postavljajte MYSQL_SSL_CA — koristi se ugrađeni CA (lib/aiven-ca.ts)

# Ime firme u PDF headeru (opciono)
# NEXT_PUBLIC_COMPANY_NAME=Moja Firma d.o.o.

JWT_SECRET=generate-a-random-uuid-here
# Jedan JWT_SECRET — nemojte AUTH_SECRET niti dupli ključ.

# Operator (nisi klijent). Zarezom odvojene adrese.
SUPERADMIN_EMAILS=
# Ili: node scripts/create-user.mjs you@example.com "<lozinka>" "Ops" superadmin

# Obavezna prijava (produkcija) — email + lozinka iz whitelist tabele users
AUTH_REQUIRED=true
# Maksimalan broj naloga (podrazumevano 3) — override za trial/starter.
# Plan limiti: trial/starter 3, pro 10, business 25.
# SEAT_LIMIT_TRIAL=3
# SEAT_LIMIT_STARTER=3
# SEAT_LIMIT_PRO=10
# SEAT_LIMIT_BUSINESS=25
MAX_USERS=3
# Maksimalan broj istovremenih uređaja po nalogu (podrazumevano 2)
MAX_DEVICES=3

# Trajanje sesije (dani): „Zapamti me“ = dugo, inače kraće
SESSION_REMEMBER_DAYS=365
SESSION_DAYS=7

# Admin sigurnost (produkcija)
ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SEC=900
ADMIN_LOGIN_LOCKOUT_SEC=1800
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SEC=900
LOGIN_LOCKOUT_SEC=900
ADMIN_CREATE_USER_MAX_PER_HOUR=8
ADMIN_CREATE_USER_COOLDOWN_SEC=60
SIGNUP_MAX_PER_HOUR=5
SIGNUP_LOCKOUT_SEC=3600

# Email (Resend). Bez ključa u dev-u se link loguje u konzolu — ne laže se da je poslato.
RESEND_API_KEY=
EMAIL_FROM="PonudeApp <onboarding@resend.dev>"
# Stabilan produkcijski URL (OAuth, mail linkovi, Stripe return). NE stavljaj preview URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — ručni tok, ista sesija (ponudeapp_session). Ne koristi NextAuth.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
# Samo stabilni domeni (ne dodaj svaki *.vercel.app preview):
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://ponudeapp.vercel.app/api/auth/google/callback
#   https://tvoj-custom-domen.com/api/auth/google/callback
# Authorized JavaScript origins: isti hostovi bez /api/...
# Aplikacija koristi NEXT_PUBLIC_APP_URL za redirect_uri (ne request origin / preview).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Isključi kreiranje nove firme preko Google (samo login postojećih): GOOGLE_SIGNUP=false
# GOOGLE_SIGNUP=true

# Health alarm (Vercel Cron → /api/cron/health, podrazumevano svakih sat)
# CRON_SECRET=dugačak-random-string   # Vercel šalje Authorization: Bearer …
# HEALTH_ALERT_EMAIL=ti@firma.com     # ili više, zarezom
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Alarm posle 2 uzastopna pada; cooldown 30 min. Treba RESEND_API_KEY za mail.

# Stripe (test mode za lokalno). Ne commitujte prave ključeve.
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Products → cene (recurring) → Price ID (price_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Lokalni webhook (u drugom terminalu):
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# pa ubaci whsec_... u STRIPE_WEBHOOK_SECRET i restartuj next dev.
# Success/cancel URL: {NEXT_PUBLIC_APP_URL}/settings/billing

# ZASTARELO: jedna zajednička lozinka — koristite users tabelu umesto ovoga
# APP_PASSWORD=

MYSQL_CONNECTION_LIMIT=10
MYSQL_MAX_IDLE=5
MYSQL_IDLE_TIMEOUT_MS=30000

# PDF → Excel converter (Python FastAPI microservice)
# Lokalno:
PDF_CONVERTER_URL=http://localhost:8000
PDF_CONVERTER_API_KEY=
PDF_CONVERTER_TIMEOUT_MS=300000
# Na Vercelu (Project env, NE Shared):
# PDF_CONVERTER_URL=https://pdfconverter-hidv.onrender.com
# PDF_CONVERTER_API_KEY=your-shared-secret
# Deploy backend/ na Render (vidi backend/README.md). API_KEY u Render env mora = PDF_CONVERTER_API_KEY na Vercelu.
# Free Render spava — prvi poziv ~50s; watchdog alarmira tek posle 2 uzastopna pada.
# Loš tekst-parser (pdf-parse) samo za debug: ALLOW_WEAK_PDF_PARSE=1
